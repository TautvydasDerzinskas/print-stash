PUID=1000
PGID=1000
DATABASE_URL=postgresql://printstash:printstash@db:5432/printstash?schema=public
FILE_STORAGE=/app/storage
API_PORT=8000
PUBLIC_URL=
CORS_ORIGINS=
# Whoever registers with this exact email becomes the instance's first admin automatically.
INITIAL_ADMIN_EMAIL=you@example.com
AUTH_SECRET=replace-with-random-secret
AUTH_TOKEN_TTL=43200
FLARESOLVERR_URL=
# Optional: leave SMTP_HOST blank to skip email verification on registration entirely (new
# accounts are verified and signed in immediately). Once set, these only seed the admin-editable
# Connections > SMTP settings on first boot -- later changes are saved via that page, not here.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PrintStash <no-reply@localhost>
