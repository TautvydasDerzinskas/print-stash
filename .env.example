PUID=1000
PGID=1000

# Used by docker-compose.deploy.yml (pre-built images from GHCR). Defaults to :latest; pin a
# specific build if you want, e.g. ghcr.io/tautvydasderzinskas/printstash-backend:sha-a8fef7d
BACKEND_IMAGE=ghcr.io/tautvydasderzinskas/printstash-backend:latest
FRONTEND_IMAGE=ghcr.io/tautvydasderzinskas/printstash-frontend:latest

POSTGRES_USER=printstash
POSTGRES_PASSWORD=printstash
POSTGRES_DB=printstash
API_PORT=8000
WEB_PORT=5173
PUBLIC_URL=
# Required if the frontend is served from a different origin than the backend (e.g. a separate
# reverse proxy giving each service its own local domain, such as printstash.mylan for the UI and
# printstash-api.mylan for the API) -- set this to the UI's origin so the browser's cross-origin
# API calls aren't blocked. Example: CORS_ORIGINS=http://printstash.mylan
CORS_ORIGINS=
AUTH_USERNAME=admin
AUTH_PASSWORD=super-secret
AUTH_SECRET=replace-with-random-secret
AUTH_TOKEN_TTL=43200
IMPORT_MOUNT_PATH=/imports
IMPORT_MOUNT_PATH_HOST=/path/to/imports
IMPORT_MOUNT_EXTS=stl,3mf,step,stp,obj,svg,png,jpg,jpeg,webp,bmp,lbrn,lbrn2,zip
IMPORT_MOUNT_INCLUDE_HIDDEN=false
IMPORT_MOUNT_ON_STARTUP=true
