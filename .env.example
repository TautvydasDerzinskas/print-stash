PUID=1000
PGID=1000

# Used by docker-compose.deploy.yml (pre-built images from GHCR). Defaults to :latest; pin a
# specific build if you want, e.g. ghcr.io/tautvydasderzinskas/printstash-backend:sha-a8fef7d
BACKEND_IMAGE=ghcr.io/tautvydasderzinskas/printstash-backend:latest
FRONTEND_IMAGE=ghcr.io/tautvydasderzinskas/printstash-frontend:latest

POSTGRES_USER=printstash
POSTGRES_PASSWORD=printstash
POSTGRES_DB=printstash
# The only port you publish -- nginx (the frontend container) serves the UI and reverse-proxies
# /api/* to the backend container internally, so the backend itself is never exposed to the host.
WEB_PORT=80
# Only needed for callers that hit the backend directly, bypassing the frontend's nginx proxy
# (e.g. a script or another service on the same host). Browser traffic through the frontend is
# always same-origin and never triggers CORS.
CORS_ORIGINS=
# Whoever registers with this exact email becomes the instance's first admin automatically.
INITIAL_ADMIN_EMAIL=you@example.com
AUTH_SECRET=replace-with-random-secret
AUTH_TOKEN_TTL=43200
# Used by the backend to get past Cloudflare's bot challenge on sites like MakerWorld during
# link import. Defaults to the flaresolverr container both compose files already start -- only
# set this if you're running FlareSolverr elsewhere.
# FLARESOLVERR_URL=http://flaresolverr:8191/v1
